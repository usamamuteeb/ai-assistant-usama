# Copy this file to .env and fill in real values. .env is gitignored.

# Required for premium-tier calls (Claude API)
ANTHROPIC_API_KEY=

# Optional: only if you want to add OpenAI as another premium backend later
OPENAI_API_KEY=

# Ollama host, only needed if not running on default localhost:11434
OLLAMA_HOST=http://localhost:11434

# Google OAuth token encryption key for cached Gmail/Calendar tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=
